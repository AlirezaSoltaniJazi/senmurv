{
  "name": "senmurv",
  "version": "1.1.1",
  "description": "QA side-panel Chrome extension: generate test data, find element locators, record & run page scripts, and track time & tasks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlirezaSoltaniJazi/senmurv"
  },
  "scripts": {
    "dev": "vite",
    "dev:firefox": "node scripts/build-firefox.mjs --watch",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode unpacked",
    "build:firefox": "tsc --noEmit && node scripts/build-firefox.mjs",
    "package": "npm run build && node scripts/zip-extension.mjs",
    "package:local": "npm run build:local && node scripts/zip-extension.mjs --suffix=local",
    "package:firefox": "npm run build:firefox && node scripts/zip-extension.mjs --suffix=firefox --dist=dist-firefox",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md,yml,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{json,md,yml,mjs}\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "prepare": "husky",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "release": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run package"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "js-beautify": "^2.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "adm-zip": "^0.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  }
}
